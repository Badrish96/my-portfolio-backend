NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/test
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
AI_ENSEMBLE_ENABLED=false
# Comma-separated models for the selected provider. For Ollama, install each model locally first.
AI_ENSEMBLE_MODELS=qwen2.5:3b,llama3.2:3b
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Use AI_PROVIDER=gemini to score with Google AI Studio / Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_CONCURRENT_REQUESTS=2
AI_DISCOVERY_SCORE_LIMIT=50
AI_DISCOVERY_AI_LIMIT=5
AI_RETRY_ATTEMPTS=2
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_SEARCH_COUNTRY=in
JOB_SEARCH_RESULTS=20
JOB_SEARCH_LOCATIONS=Gurugram,Bangalore,Noida,Delhi NCR
PORTFOLIO_API_URL=http://localhost:5000
PORTFOLIO_AUTH_TOKEN=
JOB_SEARCH_KEYWORDS=React Developer
JOB_SEARCH_LOCATION=India
COMPANY_CAREER_JOB_LIMIT=100
# JSON array of official company career sources. Supported ATS values: greenhouse, lever, ashby, smartrecruiters, or jsonld.
# Example: [{"company":"Example Technologies","ats":"greenhouse","board":"example","careersUrl":"https://boards.greenhouse.io/example"}]
COMPANY_CAREER_SOURCES=[{"company":"Google India","ats":"jsonld","careersUrl":"https://www.google.com/about/careers/applications/jobs/results/?location=India"},{"company":"Microsoft India","ats":"jsonld","careersUrl":"https://jobs.careers.microsoft.com/global/en/search?lc=India"},{"company":"Oracle India","ats":"jsonld","careersUrl":"https://www.oracle.com/careers/"},{"company":"SAP Labs India","ats":"jsonld","careersUrl":"https://jobs.sap.com/"},{"company":"TCS","ats":"jsonld","careersUrl":"https://www.tcs.com/careers/india"},{"company":"Infosys","ats":"jsonld","careersUrl":"https://career.infosys.com/"},{"company":"Wipro","ats":"jsonld","careersUrl":"https://careers.wipro.com/viewalljobs/?locale=en_US"},{"company":"HCLTech","ats":"jsonld","careersUrl":"https://www.hcltech.com/careers"},{"company":"Cognizant","ats":"jsonld","careersUrl":"https://careers.cognizant.com/"},{"company":"Accenture India","ats":"jsonld","careersUrl":"https://www.accenture.com/in-en/careers"},{"company":"Capgemini","ats":"jsonld","careersUrl":"https://www.capgemini.com/careers/"},{"company":"Tech Mahindra","ats":"jsonld","careersUrl":"https://careers.techmahindra.com/"},{"company":"IBM India","ats":"jsonld","careersUrl":"https://www.ibm.com/careers"},{"company":"Genpact","ats":"jsonld","careersUrl":"https://www.genpact.com/careers"},{"company":"Thoughtworks","ats":"jsonld","careersUrl":"https://www.thoughtworks.com/en-in/careers/jobs"},{"company":"Publicis Sapient","ats":"jsonld","careersUrl":"https://careers.publicissapient.com/"},{"company":"Nagarro","ats":"smartrecruiters","board":"Nagarro1","careersUrl":"https://jobs.smartrecruiters.com/Nagarro1/"},{"company":"Adobe India","ats":"jsonld","careersUrl":"https://www.adobe.com/careers.html"},{"company":"Gartner India","ats":"jsonld","careersUrl":"https://jobs.gartner.com/locations/gurgaon/"},{"company":"EXL Service","ats":"jsonld","careersUrl":"https://www.exlservice.com/careers"},{"company":"GrapeCity MESCIUS","ats":"jsonld","careersUrl":"https://www.grapecity.com/careers"},{"company":"Birlasoft","ats":"jsonld","careersUrl":"https://careers.birlasoft.com/"},{"company":"STMicroelectronics","ats":"jsonld","careersUrl":"https://careers.st.com/"},{"company":"ServiceNow India","ats":"jsonld","careersUrl":"https://careers.servicenow.com/"},{"company":"Rubrik India","ats":"greenhouse","board":"rubrik","careersUrl":"https://boards.greenhouse.io/rubrik"},{"company":"Bosch Engineering India","ats":"smartrecruiters","board":"BoschGroup","careersUrl":"https://jobs.smartrecruiters.com/BoschGroup/"},{"company":"Airbus India","ats":"jsonld","careersUrl":"https://www.airbus.com/en/careers"},{"company":"JPMorgan Chase India","ats":"jsonld","careersUrl":"https://careers.jpmorgan.com/"},{"company":"Wells Fargo India","ats":"jsonld","careersUrl":"https://www.wellsfargojobs.com/"},{"company":"Fidelity Investments India","ats":"jsonld","careersUrl":"https://jobs.fidelity.com/"},{"company":"PayPay India","ats":"greenhouse","board":"pay2dc","careersUrl":"https://job-boards.greenhouse.io/pay2dc"}]
LOCAL_BROWSER_PROFILE_DIR=.local-browser-profile
LOCAL_CHROME_CDP_URL=
LOCAL_CHROME_USER_DATA_DIR=
LOCAL_CHROME_PROFILE=Default
