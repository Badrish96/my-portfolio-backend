NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/test
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_CONCURRENT_REQUESTS=2
AI_RETRY_ATTEMPTS=2
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_SEARCH_COUNTRY=in
JOB_SEARCH_RESULTS=20
JOB_SEARCH_LOCATIONS=Gurugram,Bangalore,Noida,Delhi NCR
PORTFOLIO_API_URL=http://localhost:5000
PORTFOLIO_AUTH_TOKEN=
JOB_SEARCH_KEYWORDS=React Developer
JOB_SEARCH_LOCATION=India
COMPANY_CAREER_JOB_LIMIT=100
# JSON array of official company career sources. Supported ATS values: greenhouse, lever, ashby, or jsonld.
# Example: [{"company":"Example Technologies","ats":"greenhouse","board":"example","careersUrl":"https://boards.greenhouse.io/example"}]
COMPANY_CAREER_SOURCES=[]
LOCAL_BROWSER_PROFILE_DIR=.local-browser-profile
LOCAL_CHROME_CDP_URL=
LOCAL_CHROME_USER_DATA_DIR=
LOCAL_CHROME_PROFILE=Default
